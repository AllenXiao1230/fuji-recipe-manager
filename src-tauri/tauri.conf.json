{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuji Recipe Manager",
  "version": "0.1.0",
  "identifier": "com.fujirecipemanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Fuji Recipe Manager", "width": 1180, "height": 760, "minWidth": 1200, "minHeight": 640, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
